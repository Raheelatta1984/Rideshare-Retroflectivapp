{
  "name": "rideshare-retroflex",
  "private": true,
  "version": "1.0.0",
  "description": "Rear-window passenger beacon for Uber, DiDi and every rideshare.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run bff:build && npm run smoke && npm run bff:smoke",
    "audit": "node scripts/audit.mjs",
    "bff:build": "vite build --config vite.bff.config.ts",
    "bff:smoke": "node scripts/bff-smoke.mjs",
    "security:rls": "vitest run supabase/tests/rls.test.ts scripts/sql-policy-audit.test.ts",
    "security:rotate": "node scripts/rotate-admin-credential.mjs",
    "security:storage": "vitest run src/lib/security/storage-guard.test.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "jspdf": "4.2.1",
    "jszip": "3.10.2",
    "lucide-react": "1.51.0",
    "peerjs": "1.5.5",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "25.0.1",
    "jsqr": "1.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25 || >=26.0.0"
  }
}
