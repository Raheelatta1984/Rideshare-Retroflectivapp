# Retroflex — build-time configuration (Vite exposes only VITE_* variables).
#
# All of these are OPTIONAL. With none set, the app signals over the public
# PeerJS cloud and never touches a relay. Copy to .env.local to override.

# Self-hosted relay (HTTP + your own PeerJS server). Leave unset to disable the
# relay entirely — the previous build hard-coded https://relay.retroflex.app,
# which does not resolve, so every relay request failed silently.
# VITE_RELAY_SERVER=https://relay.example.com

# PeerJS signalling server. Defaults to the public cloud 0.peerjs.com:443.
# VITE_PEER_HOST=0.peerjs.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/

# TURN relay for restrictive mobile networks (optional; STUN only without it).
# Never commit real credentials — set them in Vercel's env settings.
# VITE_TURN_URL=turns:turn.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# ------------------------------------------------------------------ Phase 2
# Commercial backend. Leave ALL of these unset to run on the on-device adapter
# (fully functional, nothing shared). See PHASE-2.md.

# VITE_BACKEND=supabase            # force supabase; unset = auto-detect from the vars below
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>     # public by design; RLS policies protect the data
# VITE_SUPABASE_BUCKET=campaigns

# ------------------------------------------------------------------ Session BFF
# The same-origin session service (server/bff) is the only adapter where the
# browser never holds a bearer token. Point the app at it and the direct
# Supabase adapter above is no longer used.
#
#   VITE_BFF_BASE=/bff          # default when VITE_BACKEND=bff
#   VITE_BACKEND=bff
#
# It must be same-origin: the session cookie is __Host- + HttpOnly + SameSite=Lax.
# See docs/security/bff.md for the server-side variables.
#
# Without the BFF, Supabase sessions are memory-only and a reload requires
# signing in again. Active XSS can still use a session while the page is open.

# Manifest signing for the DIRECT Supabase adapter only. The browser verifies
# with the same symmetric key the signer uses, which means a browser key can
# also sign — a static deployment cannot have trusted manifests. With the BFF,
# signing happens server-side (BFF_MANIFEST_SECRET) and these stay unset.
# VITE_SUPABASE_MANIFEST_KEY=
# VITE_SUPABASE_MANIFEST_KEY_ID=rf-2026-01

# ------------------------------------------------------------------ Data plane
# SERVER-SIDE ONLY (process.env, e.g. a Node service or serverless function).
# These are NOT VITE_* variables and never reach the browser bundle. See
# INFRASTRUCTURE.md for how the pieces fit together.

# Write endpoint — point at PGBOUNCER, not the raw primary. For Neon use the
# -pooler endpoint (ep-….aws.neon.tech is rewritten automatically if you
# forget); for self-hosted use infra/docker-compose.yml (:6543).
# DATABASE_URL=postgres://user:pass@ep-example-pooler.aws.neon.tech/neondb

# Read replicas, comma-separated. Reads round-robin across healthy replicas
# and fall back to the primary when all are down.
# DATABASE_REPLICA_URLS=postgres://user:pass@replica-a/db,postgres://user:pass@replica-b/db

# Memcached servers, comma-separated (host:port). Absent = passthrough cache.
# MEMCACHED_URLS=127.0.0.1:11211
# MEMCACHED_DEFAULT_TTL_SECONDS=60
# Fixed-window server-side request guard (apply before DB-backed handlers).
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60

# Image logical shards → machine map (see infra/image-machines.example.json).
# IMAGE_MACHINE_MAP=infra/image-machines.json

# PgBouncer pool shape (defaults shown).
# PG_POOL_MODE=transaction
# PG_DEFAULT_POOL_SIZE=25
# PG_MIN_POOL_SIZE=5
# PG_MAX_CLIENT_CONNECTIONS=20
# PG_CHECKOUT_TIMEOUT_MS=5000

# ------------------------------------------------------------ BFF (server/bff)
# Server-side only. Never VITE_* — these must not reach the browser bundle.
# See docs/security/bff.md.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>   # only for the rotation script
# BFF_CSRF_SECRET=<32+ random characters>        # openssl rand -base64 32
# BFF_ALLOWED_ORIGINS=https://app.example.com    # exact origins, comma separated
# BFF_SESSION_KEY=<32 bytes base64>              # encrypts tokens at rest
# BFF_SESSION_STORE=postgres                     # memory | file | postgres
# BFF_DATABASE_URL=postgres://user:pass@host/db
# BFF_SESSION_FILE=/var/lib/retroflex/sessions.json
# BFF_SESSION_TTL_SECONDS=43200
# BFF_SESSION_IDLE_SECONDS=3600
# BFF_MANIFEST_SECRET=<random>                   # enables signed playlists
# BFF_STATIC_DIR=dist                            # serve the SPA same-origin
# BFF_PORT=8080
# BFF_HOST=0.0.0.0
# BFF_TRUST_PROXY=1                              # only behind a trusted proxy
# BFF_INSECURE_COOKIES=1                         # local HTTP only; refused in production
